{
  "name": "control-parental-relay",
  "version": "0.0.1",
  "private": true,
  "description": "Base local del relay del padre; todavía sin tráfico CP/1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
